# ===== 后端 =====
# JWT 签名密钥，生产环境必须修改
JWT_SECRET=feedsystem-dev-secret-key

# 后端监听端口
SERVER_PORT=8080

# MySQL（docker compose 暴露在 3307）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=feedsystem

# Redis（compose 宿主机端口为 6380，避免占用本机 6379）
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=123456
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=password123

# 上传目录（默认 backend/.run/uploads）
# UPLOAD_DIR=.run/uploads

# 关注流推拉结合：粉丝数 ≥ 阈值的作者为大V（发布只写发件箱，读取侧拉取）；
# 也可运行时用 Redis SET config:fanout_threshold <n> 覆盖（优先于本变量）
FANOUT_FOLLOWER_THRESHOLD=10000
# 粉丝收件箱保留条数 / 大V发件箱保留条数 / 扇出粉丝批大小
FANOUT_INBOX_MAX_LEN=1000
FANOUT_OUTBOX_MAX_LEN=500
FANOUT_FOLLOWER_BATCH_SIZE=500
